# ==== Namuna. Haqiqiy qiymatlarni .env fayliga (lokal) va Vercel -> Settings -> Environment Variables ga yozing ====

# Mijozlar boti tokeni (@BotFather)
CLIENT_BOT_TOKEN=1234567890:AA...
# Operator/menejerlar boti tokeni (alohida bot, @BotFather -> /newbot)
STAFF_BOT_TOKEN=1234567890:AA...

# Supabase Postgres (Transaction pooler, port 6543). Paroldagi maxsus belgilar URL-kodlangan bo'lishi kerak (% -> %25)
DATABASE_URL=postgresql://postgres.<project-ref>:<parol>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Admin(lar) Telegram ID raqami, bir nechta bo'lsa vergul bilan (@userinfobot)
ADMIN_IDS=123456789

# Webhooklarni himoyalovchi tasodifiy maxfiy satr (kamida 32 belgi):
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=

# Ixtiyoriy: ilova manzili (bo'sh bo'lsa Vercel production domeni avtomatik olinadi)
APP_URL=

# Ixtiyoriy: HTTP orqali sozlash uchun kalit (POST /api/setup, "Authorization: Bearer <SETUP_KEY>").
# Bo'sh bo'lsa bu endpoint o'chiq — sozlash `npm run setup` orqali qilinadi. Kamida 16 belgi, WEBHOOK_SECRET dan farqli.
SETUP_KEY=

# Ixtiyoriy: Mini App media havolalarini imzolash uchun alohida kalit (bo'sh bo'lsa WEBHOOK_SECRET dan hosil qilinadi)
MEDIA_SECRET=
